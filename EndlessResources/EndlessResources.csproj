<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Per-mod .csproj. Self-contained: does not depend on any shared
    MSBuild glue. Each mod is a portable unit that can be moved out of
    the workspace and still build, provided DSP + BepInEx are installed.

    When copied from the template (cursor-stuff\templates\mod-template\),
    new-mod.cmd replaces `EndlessResources` with the mod name and `EndlessResources`
    everywhere.
  -->

  <PropertyGroup>

    <AssemblyName>EndlessResources</AssemblyName>
    <RootNamespace>EndlessResources</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0.local</InformationalVersion>

    <!-- .NET target. net472 is the BepInEx / DSP requirement. -->
    <TargetFramework>net472</TargetFramework>

    <!-- C# 7.3 matches DSPMirrorBlueprint and DSPCalculator. -->
    <LangVersion>7.3</LangVersion>

    <!-- Nullable disabled to match existing DSP mod codebases. -->
    <Nullable>disable</Nullable>

    <!-- Deterministic builds for reproducible output. -->
    <Deterministic>true</Deterministic>

    <!-- Game install path. Override per machine with
         -p:GameRoot="..." or the GAME_ROOT env var. -->
    <GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Dyson Sphere Program</GameRoot>
    <GameManagedDir>$(GameRoot)\DSPGAME_Data\Managed</GameManagedDir>
    <!-- BepInExCoreDir is conditional so an explicit -p:BepInExCoreDir=...
         from the build tools (e.g. pointing at an r2modman profile's
         BepInEx\core, since DSP base installs don't ship BepInEx) is
         honored. Default = game's BepInEx\core for compatibility with
         developers who have BepInEx installed directly in the game folder. -->
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(GameRoot)\BepInEx\core</BepInExCoreDir>

    <!-- Use the game's bundled mscorlib instead of the SDK's. -->
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == '' and Exists('$(GameManagedDir)\mscorlib.dll')">$(GameManagedDir)</FrameworkPathOverride>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!--
      The template ships a manual Properties/AssemblyInfo.cs. Disable
      the SDK's auto-generation so the two don't conflict (CS0579).
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

  </PropertyGroup>

  <!--
    Game / BepInEx / Unity references. Private=false: we never copy
    BepInEx or Unity DLLs into our output directory.

    NOTE: The template that new-mod.cmd copies from was missing the
    Assembly-CSharp reference. The .csproj has been amended to add
    it; the mod's patches use [HarmonyPatch(typeof(X), ...)] which
    requires the C# compiler to resolve X at compile time. For
    defensive-reflection mods that avoid Assembly-CSharp, the
    reference can be removed and the patches converted to use
    AccessTools.TypeByName + harmony.Patch(method, ...).
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(GameManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Fail the build with a clear message if a required game DLL is
    missing. Runs before ResolveReferences.
  -->
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameRoot)' == ''" Text="GameRoot is not set. Pass -p:GameRoot=&quot;...&quot; or set the GAME_ROOT env var." />
    <Error Condition="!Exists('$(GameRoot)')" Text="GameRoot directory does not exist: $(GameRoot)" />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx.dll was not found under GameRoot '$(GameRoot)'. Install BepInEx 5 first." />
    <Error Condition="!Exists('$(BepInExCoreDir)\0Harmony.dll')" Text="0Harmony.dll was not found under GameRoot '$(GameRoot)'. Install BepInEx 5 first." />
    <Error Condition="!Exists('$(GameManagedDir)\netstandard.dll')" Text="netstandard.dll was not found under GameRoot '$(GameRoot)'." />
    <Error Condition="!Exists('$(GameManagedDir)\UnityEngine.dll')" Text="UnityEngine.dll was not found under GameRoot '$(GameRoot)'." />
    <Error Condition="!Exists('$(GameManagedDir)\UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll was not found under GameRoot '$(GameRoot)'." />
    <Error Condition="!Exists('$(GameManagedDir)\UnityEngine.InputLegacyModule.dll')" Text="UnityEngine.InputLegacyModule.dll was not found under GameRoot '$(GameRoot)'." />
    <Error Condition="!Exists('$(GameManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found under GameRoot '$(GameRoot)'." />
  </Target>

  <!--
    PostBuild: copy the built DLL to BepInEx\plugins\<ModName>\ so the
    developer can launch the game and test without a manual copy.
    Override the destination by setting the BepInExPluginsDir property.

    Deliberately does NOT deploy the .pdb - Thunderstore releases
    don't ship debug symbols, and having a stale/mismatched .pdb
    sitting next to the deployed .dll in a dev BepInEx\plugins\
    folder is more confusing than helpful. (2026-08-11: this used to
    copy the .pdb too; removed after it turned up in a deployed
    plugins folder unexpectedly.)
  -->
  <Target Name="DeployToBepInEx" AfterTargets="Build">
    <PropertyGroup>
      <BepInExPluginsDir Condition="'$(BepInExPluginsDir)' == ''">$(GameRoot)\BepInEx\plugins\$(AssemblyName)</BepInExPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(BepInExPluginsDir)" />
    <ItemGroup>
      <_DeployFiles Include="$(TargetPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(BepInExPluginsDir)" SkipUnchangedFiles="true" />
    <Message Text="Deployed $(AssemblyName) -> $(BepInExPluginsDir)" Importance="high" />
  </Target>

  <!--
    PostBuild (optional): also deploy the DLL to a r2modman profile's
    BepInEx\plugins\ folder (no .pdb - see DeployToBepInEx). Fires
    after DeployToBepInEx.
    Only runs if R2ModmanProfilePath is set. Typical r2modman path:
      C:\Users\<user>\AppData\Roaming\r2modmanPlus-local\
        DysonSphereProgram\profiles\<profile-name>

    Enable via:
      -p:R2ModmanProfilePath="C:\Users\veesa\AppData\Roaming\r2modmanPlus-local\DysonSphereProgram\profiles\mod-testing"
    or the R2MODMAN_PROFILE_PATH env var.
  -->
  <Target Name="DeployToR2Modman" AfterTargets="DeployToBepInEx" Condition="'$(R2ModmanProfilePath)' != ''">
    <PropertyGroup>
      <_R2ModmanPluginsDir>$(R2ModmanProfilePath)\BepInEx\plugins\$(AssemblyName)</_R2ModmanPluginsDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(R2ModmanProfilePath)')" Text="R2ModmanProfilePath does not exist: $(R2ModmanProfilePath)" />
    <MakeDir Directories="$(_R2ModmanPluginsDir)" />
    <ItemGroup>
      <_R2ModmanDeployFiles Include="$(TargetPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(_R2ModmanDeployFiles)" DestinationFolder="$(_R2ModmanPluginsDir)" SkipUnchangedFiles="true" />
    <Message Text="Deployed $(AssemblyName) -> $(_R2ModmanPluginsDir)" Importance="high" />
  </Target>

  <!--
    PostBuild: deploy r2modman-format metadata (manifest.json + README.md)
    alongside the DLL. Runs after DeployToR2Modman (which itself runs
    after DeployToBepInEx), so all three deploy targets fire in order.

    r2modman expects the plugin folder to contain:
      <ModName>.dll              (deployed by DeployToBepInEx / DeployToR2Modman)
      manifest.json              (deployed by this target)
      README.md                  (deployed by this target)
      icon.png                   (optional; we leave it out per current policy)

    Without manifest.json, r2modman shows the mod as "Unknown" or hides it
    entirely. With manifest.json, it shows the proper name, version, and
    description. The icon field in the manifest is omitted; r2modman will
    show a default placeholder.
  -->
  <Target Name="DeployMetadata" AfterTargets="DeployToR2Modman">
    <ItemGroup>
      <_MetadataFiles Include="$(MSBuildThisFileDirectory)manifest.json" />
      <_MetadataFiles Include="$(MSBuildThisFileDirectory)README.md" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    </ItemGroup>

    <!-- Deploy to game BepInEx plugins (always) -->
    <Copy SourceFiles="@(_MetadataFiles)" DestinationFolder="$(BepInExPluginsDir)" SkipUnchangedFiles="true" />
    <Message Text="Deployed metadata -> $(BepInExPluginsDir)" Importance="high" />

    <!-- Deploy to r2modman profile (if set) -->
    <Copy SourceFiles="@(_MetadataFiles)"
          DestinationFolder="$(R2ModmanProfilePath)\BepInEx\plugins\$(AssemblyName)"
          SkipUnchangedFiles="true"
          Condition="'$(R2ModmanProfilePath)' != ''" />
    <Message Text="Deployed metadata -> $(R2ModmanProfilePath)\BepInEx\plugins\$(AssemblyName)"
             Importance="high"
             Condition="'$(R2ModmanProfilePath)' != ''" />
  </Target>

</Project>
