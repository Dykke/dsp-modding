# DSPModding workspace .gitignore

# Private working notes (per new-chat.md)
cursor-stuff/

# Per-mod private dev notes / non-code assets (per new-chat.md 2026-08-11
# revision). Matches every mod folder at the repo root, present and future.
*/notes/
*/non-code/

# Build output
**/bin/
**/obj/
artifacts/

# IDE
.vs/
*.user
*.suo
.idea/
*.swp
*.tmp
*.bak

# OS
.DS_Store
Thumbs.db

# Never commit game / BepInEx binaries
BepInEx/
DSPGAME_Data/

# Local per-machine overrides
*.local.cfg
